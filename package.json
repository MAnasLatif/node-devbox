{
  "name": "node-devbox",
  "version": "1.1.0",
  "description": "Create isolated Node.js development environments with Docker Compose.",
  "type": "module",
  "bin": {
    "node-devbox": "dist/src/node-devbox.js"
  },
  "files": [
    "dist/src",
    "src",
    "tsconfig.json",
    "docker-compose.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build --clean tsconfig.json && tsc --build tsconfig.json",
    "test": "npm run build && node --test dist/test/scaffold.test.js",
    "check": "npm test && npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20.10"
  },
  "keywords": [
    "node",
    "docker",
    "docker-compose",
    "devcontainer",
    "development-environment",
    "github-cli"
  ],
  "author": {
    "name": "M Anas Latif",
    "url": "https://github.com/MAnasLatif"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAnasLatif/node-devbox.git"
  },
  "bugs": {
    "url": "https://github.com/MAnasLatif/node-devbox/issues"
  },
  "homepage": "https://github.com/MAnasLatif/node-devbox#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
